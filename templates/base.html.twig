<!doctype html>
<html lang="{{ app.request.locale|default('en') }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta
		name="csrf-token" content="{{ csrf_token('authenticate') }}">
		{# CSRF token for security #}
		<title>
			{% block title %}Aarti - Admin Dashboard
			{% endblock %}
		</title>
		<link rel="shortcut icon" type="image/png" href="{{ asset('assets/images/logos/favicon.png') }}"/>
		<link
		rel="stylesheet" href="{{ asset('assets/css/styles.min.css') }}"/>
		{# Font Awesome for icons (if not already included in styles.min.css) #}
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer"/> {% block stylesheets %}{% endblock %}
		</head>
		<body>
			<!-- Body Wrapper -->
			<div
				class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full" data-sidebar-position="fixed" data-header-position="fixed">
				<!-- Sidebar Start -->
				<aside
					class="left-sidebar">
					<!-- Sidebar scroll-->
					<div>
						<div class="brand-logo d-flex align-items-center justify-content-between">
							<a href="{{ path('admin_event_index') }}" class="text-nowrap logo-img">
								<img src="{{ asset('assets/images/logo.jpg') }}" width="180" alt="Aarti Logo"/>
							</a>
							<div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer" id="sidebarCollapse">
								<i class="fas fa-times fs-8"></i>
							</div>
						</div>
						<!-- Sidebar navigation-->
						<nav class="sidebar-nav scroll-sidebar" data-simplebar="">
							<ul id="sidebarnav">
								<li class="nav-small-cap">
									<i class="fas fa-ellipsis-h nav-small-cap-icon fs-4"></i>
									<span class="hide-menu">Menu</span>
								</li>
								<li class="sidebar-item">
									<a class="sidebar-link" href="{{ path('app_dashboard') }}" aria-expanded="false">
										<span>
											<i class="fas fa-tachometer-alt"></i>
										</span>
										<span class="hide-menu">Dashboard</span>
									</a>
								</li>
								<li class="sidebar-item">
									<a class="sidebar-link" href="{{ path('admin_event_index') }}" aria-expanded="false">
										<span>
											<i class="fas fa-calendar-alt"></i>
										</span>
										<span class="hide-menu">Events</span>
									</a>
								</li>
								<li class="sidebar-item">
									<a class="sidebar-link" href="{{ path('app_user_index') }}" aria-expanded="false">
										<span>
											<i class="fas fa-users"></i>
										</span>
										<span class="hide-menu">Users Management</span>
									</a>
								</li>
								<li class="sidebar-item">
                                    <a class="sidebar-link" href="{{ path('admin_produit_index') }}" aria-expanded="false">
                                        <span>
                                            <i class="fas fa-box"></i>
                                        </span>
                                        <span class="hide-menu">Product Management</span>
                                    </a>
                                </li>

                                
                                <li class="sidebar-item">
                                    <a class="sidebar-link" href="{{ path('app_livreur_index') }}" aria-expanded="false">
                                        <span>
                                            <i class="fas fa-truck"></i>
                                        </span>
                                        <span class="hide-menu">Gérer les Livreurs</span>
                                    </a>
                                </li>
                                

                                <li class="sidebar-item">
                                    <a class="sidebar-link" href="{{ path('app_orders') }}" aria-expanded="false">
                                        <span>
                                            <i class="fas fa-shopping-cart"></i>
                                        </span>
                                        <span class="hide-menu">Gestion des Commandes</span>
                                    </a>
                                </li>

								<li class="sidebar-item">
									<a class="sidebar-link" href="{{ path('app_atelier_index') }}" aria-expanded="false">
										<span>
											<i class="ti ti-tools"></i>
										</span>
										<span class="hide-menu">Ateliers</span>
									</a>
								</li>

								
							</ul>
						</nav>
						<!-- End Sidebar navigation -->
					</div>
					<!-- End Sidebar scroll-->
				</aside>
				<!-- Sidebar End -->
				<!-- Main wrapper -->
				<div
					class="body-wrapper">
					<!-- Header Start -->
					<header class="app-header">
						<nav class="navbar navbar-expand-lg navbar-light">
							<ul class="navbar-nav">
								<li class="nav-item d-block d-xl-none">
									<a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
										<i class="fas fa-bars"></i>
									</a>
								</li>
							</ul>
							<div class="navbar-collapse justify-content-end px-0" id="navbarNav">
								<ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">
									{% if app.user %}
										<li class="nav-item dropdown">
											<a class="nav-link nav-icon-hover d-flex align-items-center" href="javascript:void(0)" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
												<img src="{{ asset('assets/images/profile/user-1.jpg') }}" alt="User Profile" width="35" height="35" class="rounded-circle me-2">
												<span class="d-none d-md-inline">{{ app.user.fullName ?? app.user.email }}</span>
											</a>
											<div class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">													
												<div class="dropdown-divider"></div>
												<a class="dropdown-item text-danger" href="{{ path('app_logout') }}" data-method="POST">
													<i class="fas fa-sign-out-alt me-2"></i>
													Logout
												</a>
											</div>
										</li>
									{% else %}
										<li class="nav-item">
											<a class="nav-link" href="{{ path('app_sign_in') }}">
												<i class="fas fa-sign-in-alt me-1"></i>
												Login
											</a>
										</li>
										<li class="nav-item ms-2 d-none d-md-block">
											<a class="btn btn-primary btn-sm" href="{{ path('app_sign_up') }}">
												<i class="fas fa-user-plus me-1"></i>
												Sign Up
											</a>
										</li>
									{% endif %}
								</ul>
							</div>
						</nav>
					</header>
					<!-- Header End -->
					<div
						class="container-fluid">
						{# Flash Messages #}
						{% for flash_message in app.flashes('success') %}
							<div class="alert alert-success alert-dismissible fade show" role="alert">
								{{ flash_message }}
								<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
							</div>
						{% endfor %}
						{% for flash_message in app.flashes('error') %}
							<div class="alert alert-danger alert-dismissible fade show" role="alert">
								{{ flash_message }}
								<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
							</div>
						{% endfor %}
						{% block body %}{% endblock %}
					</div>
				</div>
			</div>

			{# JavaScript Assets #}
			<script src="{{ asset('assets/libs/jquery/dist/jquery.min.js') }}"></script>
			<script src="{{ asset('assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js') }}"></script>
			<script src="{{ asset('assets/libs/simplebar/dist/simplebar.min.js') }}"></script>
			<script src="{{ asset('assets/js/sidebarmenu.js') }}"></script>
			<script src="{{ asset('assets/js/app.min.js') }}"></script>
			{% block javascripts %}{% endblock %}
		</body>
	</html>
