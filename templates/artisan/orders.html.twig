{% extends 'base.html.twig' %}

{% block title %}Mes Commandes{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Mes Commandes</h1>
    
    {# Debug information #}
<div class="container mt-3 mb-3">
    <div class="alert alert-info">
        <h5>Debug Information</h5>
        <p>Artisan ID: {{ artisan.id }}</p>
        <p>Number of orders: {{ orders|length }}</p>
        {% if orders|length > 0 %}
            <p>Order IDs: {{ orders|map(o => o.orderId)|join(', ') }}</p>
        {% endif %}
    </div>
</div>

{% if orders|length > 0 %}
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th># Commande</th>
                    <th>Date de commande</th>
                    <th>Date de livraison</th>
                    <th>Statut</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                    {% for order in orders %}
                        {% set orderTotal = order.getTotalForArtisan(app.user) %}
                        {% set orderItems = order.getItemsByArtisan(app.user) %}
                        {% if orderItems|length > 0 %}
                            <tr>
                                <td>{{ order.orderId }}</td>
                                <td>{{ order.deliveryDate ? order.deliveryDate|date('d/m/Y') : 'Non spécifiée' }}</td>
                                <td>
                                    <span class="badge 
                                        {% if order.commande and order.commande.statut == 'En préparation' %}bg-warning
                                        {% elseif order.commande and order.commande.statut == 'En livraison' %}bg-info
                                        {% elseif order.commande and order.commande.statut == 'Livrée' %}bg-success
                                        {% elseif order.commande and order.commande.statut == 'Annulée' %}bg-danger
                                        {% else %}bg-secondary{% endif %}">
                                        {{ order.commande ? order.commande.statut : 'Nouvelle' }}
                                    </span>
                                </td>
                                <td>{{ orderTotal|number_format(2, ',', ' ') }} TND</td>
                                <td>
                                    <a href="{{ path('app_order_show', {'order_id': order.orderId}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i> Voir détails
                                    </a>
                                    
                                    {% if not is_granted('ROLE_ARTISAN') and order.commande and order.commande.statut == 'En préparation' %}
                                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#assignLivreurModal{{ order.commande.id }}">
                                            <i class="fas fa-truck"></i> Assigner livreur
                                        </button>
                                        
                                        <!-- Assign Livreur Modal -->
                                        <div class="modal fade" id="assignLivreurModal{{ order.commande.id }}" tabindex="-1" aria-labelledby="assignLivreurModalLabel" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="assignLivreurModalLabel">Assigner un livreur</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form action="{{ path('app_commande_assign_livreur', {'id': order.commande.id}) }}" method="post">
                                                        <div class="modal-body">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('assign_livreur' ~ order.commande.id) }}">
                                                            <div class="mb-3">
                                                                <label for="livreur_id" class="form-label">Sélectionner un livreur</label>
                                                                <select name="livreur_id" id="livreur_id" class="form-select" required>
                                                                    <option value="">Choisir un livreur</option>
                                                                    {% for livreur in livreurs %}
                                                                        <option value="{{ livreur.id }}">{{ livreur.username }} ({{ livreur.telephone ?? 'Pas de téléphone' }})</option>
                                                                    {% endfor %}
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                            <button type="submit" class="btn btn-primary">Confirmer</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                    
                                    {% if order.commande and order.commande.livreur %}
                                        <div class="mt-2">
                                            <small class="text-muted">
                                                <i class="fas fa-truck"></i> Livreur: {{ order.commande.livreur.username }}
                                                {% if order.commande.livreur.telephone %}
                                                    ({{ order.commande.livreur.telephone }})
                                                {% endif %}
                                            </small>
                                        </div>
                                    {% endif %}
                                </td>
                            </tr>
                            
                            <!-- Order Items Details (Collapsible) -->
                            <tr>
                                <td colspan="5" class="p-0">
                                    <div class="collapse" id="orderItems{{ order.orderId }}">
                                        <div class="card card-body bg-light">
                                            <h6>Détails de la commande</h6>
                                            <table class="table table-sm">
                                                <thead>
                                                    <tr>
                                                        <th>Produit</th>
                                                        <th class="text-end">Prix unitaire</th>
                                                        <th class="text-center">Quantité</th>
                                                        <th class="text-end">Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for item in orderItems %}
                                                        <tr>
                                                            <td>{{ item.produit.nom }}</td>
                                                            <td class="text-end">{{ item.prix|number_format(2, ',', ' ') }} TND</td>
                                                            <td class="text-center">{{ item.quantite }}</td>
                                                            <td class="text-end">{{ (item.prix * item.quantite)|number_format(2, ',', ' ') }} TND</td>
                                                        </tr>
                                                    {% endfor %}
                                                    <tr class="table-active">
                                                        <th colspan="3" class="text-end">Total:</th>
                                                        <th class="text-end">{{ orderTotal|number_format(2, ',', ' ') }} TND</th>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i> Aucune commande trouvée.
        </div>
    {% endif %}
</div>

{% block javascripts %}
    {{ parent() }}
    <script>
        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
            
            // Toggle order items
            document.querySelectorAll('.toggle-order-items').forEach(button => {
                button.addEventListener('click', function() {
                    const target = document.querySelector(this.getAttribute('data-bs-target'));
                    const icon = this.querySelector('i');
                    if (target.classList.contains('show')) {
                        icon.classList.remove('fa-chevron-up');
                        icon.classList.add('fa-chevron-down');
                    } else {
                        icon.classList.remove('fa-chevron-down');
                        icon.classList.add('fa-chevron-up');
                    }
                });
            });
        });
    </script>
{% endblock %}

{% endblock %}
