{% extends 'basef.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mes commandes</h1>
        <a href="{{ path('app_shop_index') }}" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left me-1"></i> Retour à la boutique
        </a>
    </div>

    {% if orders|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Commande</th>
                        <th>Date de livraison</th>
                        <th>Statut</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                    <tr>
                        <td>
                            <a href="{{ path('app_order_show', {'order_id': order.orderId}) }}" class="text-decoration-none">
                                #{{ order.orderId }}
                            </a>
                        </td>
                        <td>{{ order.deliveryDate|date('d/m/Y') }}</td>
                        <td>
                            <span class="badge bg-{{ 
                                order.status == 'DELIVERED' ? 'success' : 
                                (order.status == 'CANCELLED' ? 'danger' : 'primary') 
                            }}">
                                {{ order.status }}
                            </span>
                        </td>
                        <td class="text-end">{{ order.totalPrice|number_format(2, ',', ' ') }} TND</td>
                        <td class="text-end">
                            <a href="{{ path('app_order_show', {'order_id': order.orderId}) }}" 
                               class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-eye"></i> Voir
                            </a>
                            {% if order.status == 'PENDING' %}
                                <form action="{{ path('app_order_cancel', {'order_id': order.orderId}) }}" method="post" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ order.orderId) }}">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">
                                        <i class="fas fa-times"></i> Annuler
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="text-center py-5">
            <i class="fas fa-shopping-bag fa-4x text-muted mb-3"></i>
            <h4>Vous n'avez pas encore passé de commande</h4>
            <p class="text-muted">Parcourez notre boutique et découvrez nos produits artisanaux</p>
            <a href="{{ path('app_shop_index') }}" class="btn btn-primary">
                <i class="fas fa-shopping-bag me-2"></i>Voir la boutique
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}