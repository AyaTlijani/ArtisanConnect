{% extends 'baseF.html.twig' %}

{% block title %}Nos Ateliers{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/atelier-index.css') }}">
{% endblock %}

{% block body %}
    <div class="container py-5">
        <!-- Page Header -->
        <h1 class="mb-4">Nos Ateliers</h1>
        <p class="lead text-muted mb-5">Explorez notre sélection d'ateliers créatifs et éducatifs pour tous les âges et tous les niveaux.</p>

        <!-- Ateliers List -->
        <div class="row">
            {% for atelier in ateliers %}
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm atelier-card">
                        <!-- Atelier Image -->
                        <div class="card-img-container">
                            {% if atelier.image %}
                                <img src="{{ vich_uploader_asset(atelier, 'imageFile') }}" class="card-img-top" alt="{{ atelier.nom|e }}" style="height: 200px; object-fit: cover;" loading="lazy">
                            {% else %}
                                <img src="{{ asset('assets/images/default-atelier.jpg') }}" class="card-img-top" alt="{{ atelier.nom|e }}" style="height: 200px; object-fit: cover;" loading="lazy">
                            {% endif %}
                        </div>

                        <!-- Atelier Details -->
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ atelier.nom|u.truncate(30, '...') }}</h5>
                            <p class="card-text flex-grow-1">{{ atelier.description|u.truncate(100, '...') }}</p>

                            <!-- Star Rating -->
                            <div class="mb-2">
                                {% include 'components/_rating_stars.html.twig' with {'entity': atelier, 'entityType': 'atelier'} %}
                                <span class="text-muted small ms-2">({{ atelier.ratings|length }})</span>
                            </div>

                            <!-- Price and Availability -->
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <div>
                                    <span class="h5 text-primary mb-0">{{ atelier.prix|number_format(2, ',', ' ') }} TND</span>
                                    {% if atelier.quantite > 0 %}
                                        <span class="badge bg-success ms-2">Disponible</span>
                                    {% else %}
                                        <span class="badge bg-danger ms-2">Complet</span>
                                    {% endif %}
                                </div>
                                
                            </div>

                            <!-- Discover Button -->
                            <a href="{{ path('app_atelier_show', {'idAtelier': atelier.idAtelier}) }}"
                               class="btn btn-primary w-100 mt-2"
                               aria-label="Découvrir l'atelier {{ atelier.nom }}">
                                <i class="fas fa-eye me-1"></i> Découvrir
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="no-ateliers">
                        <i class="fas fa-paint-brush" aria-hidden="true"></i>
                        <h3>Aucun atelier disponible</h3>
                        <p class="text-muted">Revenez bientôt pour découvrir nos prochains ateliers.</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/atelier-index.js') }}"></script>
{% endblock %}