{% extends 'basef.html.twig' %}

{% block title %}{{ atelier.nom }} - Détails de l'Atelier{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        #atelierMap {
            height: 300px;
            width: 100%;
            border-radius: 8px;
            margin-top: 1rem;
            border: 1px solid #dee2e6;
        }
        .leaflet-popup-content {
            text-align: center;
        }
        .map-container {
            margin-top: 1.5rem;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
        }
        .map-header {
            background-color: #f8f9fa;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #dee2e6;
            font-weight: 600;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            {% if atelier.image %}
                                <img src="{{ vich_uploader_asset(atelier, 'imageFile') }}" alt="{{ atelier.nom }}" class="img-fluid rounded">
                            {% else %}
                                <img src="{{ asset('assets/images/1.jpg') }}" alt="{{ atelier.nom }}" class="img-fluid rounded">
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h1 class="mb-3">{{ atelier.nom }}</h1>
                        
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h3 class="text-primary mb-0">{{ atelier.prix }} TND</h3>
                                {% include 'components/_rating_stars.html.twig' with {'entity': atelier, 'entityType': 'atelier'} %}
                            </div>
                            <p class="mt-3">{{ atelier.description|nl2br }}</p>
                            
                            <div class="mt-4">
                                <p class="mb-1"><strong>Catégorie:</strong> {{ atelier.categorie }}</p>
                                <p class="mb-1"><strong>Places disponibles:</strong> {{ atelier.quantite }}</p>
                                <p class="mb-1"><strong>Statut:</strong> 
                                    {% if atelier.disponibilite %}
                                        <span class="text-success">Disponible</span>
                                    {% else %}
                                        <span class="text-danger">Complet</span>
                                    {% endif %}
                                </p>
                                <p class="mb-1"><strong>Animateur:</strong> {{ atelier.fournisseur ? atelier.fournisseur.username : 'À confirmer' }}</p>
                                <p class="mb-1"><strong>Localisation:</strong> {{ atelier.location }}</p>
                            
                            <!-- Map Container -->
                            <div class="map-container">
                                <div class="map-header">
                                    <i class="fas fa-map-marker-alt me-2 text-danger"></i>Localisation sur la carte
                                </div>
                                <div id="atelierMap"></div>
                            </div>
                            </div>
                            
                            <div class="d-flex gap-2 mt-4">
                                {% if atelier.disponibilite and atelier.quantite > 0 %}
                                    <a href="#" class="btn btn-primary">
                                        <i class="fas fa-calendar-plus me-2"></i>Réserver maintenant
                                    </a>
                                {% else %}
                                    <button class="btn btn-secondary" disabled>Complet</button>
                                {% endif %}
                                
                            </div>
                            
                            <!-- Ratings Section -->
                            <div class="mt-5">
                                <h4>Notes et avis</h4>
                                <div class="card">
                                    <div class="card-body">
                                        {% if atelier.ratings|length > 0 %}
                                            <div class="mb-3">
                                                <div class="d-flex align-items-center mb-3">
                                                    <div class="display-4 me-3">{{ "%0.1f"|format(atelier.averageRating|default(0)) }}</div>
                                                    <div>
                                                        {% include 'components/_rating_stars.html.twig' with {'entity': atelier, 'entityType': 'atelier'} %}
                                                        <div class="text-muted small">Basé sur {{ atelier.ratings|length }} avis</div>
                                                    </div>
                                                </div>
                                                
                                                <!-- Rating Distribution -->
                                                <div class="rating-distribution">
                                                    {% for i in 5..1 %}
                                                        {% set count = atelier.ratings|filter(r => r.rating == i)|length %}
                                                        {% set percentage = atelier.ratings|length > 0 ? (count / atelier.ratings|length * 100) : 0 %}
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="text-nowrap me-2" style="width: 30px;">{{ i }} <i class="fas fa-star text-warning"></i></div>
                                                            <div class="progress flex-grow-1" style="height: 20px;">
                                                                <div class="progress-bar bg-warning" role="progressbar" style="width: {{ percentage }}%" 
                                                                     aria-valuenow="{{ percentage }}" aria-valuemin="0" aria-valuemax="100"></div>
                                                            </div>
                                                            <div class="ms-2 text-muted small" style="width: 40px;">{{ count }}</div>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                            
                                            <!-- Reviews List -->
                                            <div class="reviews-list">
                                                <h5 class="mb-3">Avis récents</h5>
                                                {% for rating in atelier.ratings|slice(0, 3) %}
                                                    <div class="review-item mb-3 pb-3 border-bottom">
                                                        <div class="d-flex justify-content-between">
                                                            <div class="fw-bold">{{ rating.user.getNom() ?? 'Anonyme' }}</div>
                                                            <div class="text-muted small">
                                                                {{ rating.createdAt|date('d/m/Y') }}
                                                            </div>
                                                        </div>
                                                        <div class="text-warning mb-2">
                                                            {% for i in 1..5 %}
                                                                <i class="fas {{ i <= rating.rating ? 'fa-star' : 'far fa-star' }}"></i>
                                                            {% endfor %}
                                                        </div>
                                                        {% if rating.comment %}
                                                            <p class="mb-0">{{ rating.comment }}</p>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <p class="text-muted mb-0">Aucun avis pour le moment. Soyez le premier à noter cet atelier !</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Related Workshops (if any) -->
                {% if relatedAteliers|default([])|length > 0 %}
                    <div class="mt-5">
                        <h3 class="mb-4">Ateliers similaires</h3>
                        <div class="row">
                            {% for related in relatedAteliers %}
                                <div class="col-md-4 mb-4">
                                    <div class="card h-100">
                                        {% if related.image %}
                                            <img src="{{ vich_uploader_asset(related, 'imageFile') }}" class="card-img-top" alt="{{ related.nom }}" style="height: 200px; object-fit: cover;">
                                        {% else %}
                                            <img src="{{ asset('assets/images/1.jpg') }}" class="card-img-top" alt="{{ related.nom }}" style="height: 200px; object-fit: cover;">
                                        {% endif %}
                                        <div class="card-body">
                                            <h5 class="card-title">{{ related.nom }}</h5>
                                            <p class="card-text">{{ related.description|u.truncate(100, '...') }}</p>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="h5 mb-0 text-primary">{{ related.prix }} TND</span>
                                                <a href="{{ path('app_atelier_show', {'idAtelier': related.idAtelier}) }}" class="btn btn-sm btn-outline-primary">Voir plus</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Default coordinates (Tunisia center)
            const defaultLat = 36.8065;
            const defaultLng = 10.1815;
            const zoomLevel = 13;
            
            // Get location string from the atelier
            const locationString = "{{ atelier.location|e('js') }}";
            const mapElement = document.getElementById('atelierMap');
            
            // Initialize the map with default coordinates
            const map = L.map('atelierMap').setView([defaultLat, defaultLng], zoomLevel);
            
            // Add OpenStreetMap tiles
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);
            
            // Add a marker with the atelier location
            const addMarker = (lat, lng, title, address) => {
                const marker = L.marker([lat, lng]).addTo(map);
                marker.bindPopup(`
                    <b>${title}</b><br>
                    <small>${address}</small>
                `).openPopup();
                return marker;
            };
            
            // Try to geocode the location string
            const geocodeLocation = async () => {
                try {
                    const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationString)}`);
                    const data = await response.json();
                    
                    if (data && data[0]) {
                        const lat = parseFloat(data[0].lat);
                        const lon = parseFloat(data[0].lon);
                        
                        // Update map view
                        map.setView([lat, lon], zoomLevel);
                        
                        // Add marker
                        addMarker(
                            lat, 
                            lon, 
                            '{{ atelier.nom|e('js') }}', 
                            locationString
                        );
                    } else {
                        // If geocoding fails, show the default view with an error marker
                        const marker = addMarker(
                            defaultLat, 
                            defaultLng, 
                            'Emplacement non trouvé', 
                            'Impossible de localiser cette adresse sur la carte.'
                        );
                        marker.openPopup();
                    }
                } catch (error) {
                    console.error('Erreur de géocodage:', error);
                    // Show default view with error message
                    const marker = addMarker(
                        defaultLat, 
                        defaultLng, 
                        'Erreur de chargement', 
                        'Impossible de charger la carte pour le moment.'
                    );
                    marker.openPopup();
                }
            };
            
            // Trigger geocoding
            geocodeLocation();
        });
    </script>
{% endblock %}