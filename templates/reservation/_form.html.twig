{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
    <div class="row">
        {% for field in form %}
            {% if field.vars.name != '_token' %}
                <div class="col-md-6 mb-3">
                    {{ form_label(field, null, {'label_attr': {'class': 'form-label'}}) }}
                    {% if field.vars.name == 'imageFile' %}
                        {{ form_widget(field.file, {'attr': {'class': 'form-control'}}) }}
                        {% if field.delete is defined %}
                            <div class="form-check mt-2">
                                {{ form_widget(field.delete, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(field.delete, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        {% endif %}
                    {% elseif field.vars.type == 'choice' and field.vars.multiple %}
                        {{ form_widget(field, {'attr': {'class': 'form-select'}}) }}
                    {% elseif field.vars.type == 'checkbox' %}
                        {{ form_widget(field, {'attr': {'class': 'form-check-input'}}) }}
                    {% else %}
                        {{ form_widget(field, {'attr': {'class': 'form-control'}}) }}
                    {% endif %}
                    {{ form_errors(field, {'attr': {'class': 'text-danger'}}) }}
                </div>
            {% endif %}
        {% endfor %}
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="ti ti-check me-1"></i> {{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ cancel_path }}" class="btn btn-secondary">
            <i class="ti ti-arrow-left me-1"></i> Annuler
        </a>
    </div>
{{ form_end(form) }}