{% extends 'base.html.twig' %}

{% block title %}Manage Products{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Products</h4>
            <a href="{{ path('admin_produit_new') }}" class="btn btn-primary mb-3">Add New Product</a>
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Available</th>
                        <th>Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for produit in produits %}
                        <tr>
                            <td>{{ produit.idProduit }}</td>
                            <td>{{ produit.nom }}</td>
                            <td>{{ produit.prix }}</td>
                            <td>{{ produit.quantite }}</td>
                            <td>{{ produit.disponibilite ? 'Yes' : 'No' }}</td>
                            <td>{{ produit.categorie }}</td>
                            <td>
                                <a href="{{ path('admin_produit_show', {'id': produit.idProduit}) }}" class="btn btn-sm btn-info">Show</a>
                                <a href="{{ path('admin_produit_edit', {'id': produit.idProduit}) }}" class="btn btn-sm btn-warning">Edit</a>
                                <form method="post" action="{{ path('admin_produit_delete', {'id': produit.idProduit}) }}" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.idProduit) }}">
                                    <button class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}