{% extends 'base.html.twig' %}

{% block title %}Gestion des Livreurs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .availability-badge {
            font-size: 0.8rem;
            padding: 0.3rem 0.6rem;
            border-radius: 50rem;
        }
        .table-actions {
            white-space: nowrap;
            width: 1%;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0">{% block page_title %}{% endblock %}</h4>
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                            <li class="breadcrumb-item"><a href="{{ path('app_livreur_index') }}">Livreurs</a></li>
                            <li class="breadcrumb-item active">{% block breadcrumb_active %}{% endblock %}</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% block livreur_content %}{% endblock %}
    </div>
{% endblock %}
