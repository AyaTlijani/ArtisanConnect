<form method="post" action="{{ path('app_livreur_delete', {'id': livreur.id}) }}" 
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement ce livreur ? Cette action est irréversible.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ livreur.id) }}">
    <button class="btn btn-danger">
        <i class="fas fa-trash-alt me-1"></i> Supprimer définitivement
    </button>
</form>
