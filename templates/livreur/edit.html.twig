{% extends 'livreur/base.html.twig' %}

{% block page_title %}Modifier Livreur
{% endblock %}
{% block breadcrumb_active %}Modifier
	{{ livreur.nom }}
{% endblock %}

{% block livreur_content %}
	<div class="row">
		<div class="col-12">
			<div class="card">
				<div class="card-header bg-white">
					<h5 class="mb-0">Modifier le Livreur</h5>
				</div>
				<div class="card-body">
					{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
					<div class="row">
						<div class="col-md-6 mb-3">
							{{ form_label(form.nom, 'Nom du livreur', {'label_attr': {'class': 'form-label'}}) }}
							{{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
							<div class="invalid-feedback">
								{{ form_errors(form.nom) }}
							</div>
						</div>
						<div class="col-md-6 mb-3">
							{{ form_label(form.vehicule, 'Véhicule', {'label_attr': {'class': 'form-label'}}) }}
							{{ form_widget(form.vehicule, {'attr': {'class': 'form-control'}}) }}
							<div class="invalid-feedback">
								{{ form_errors(form.vehicule) }}
							</div>
						</div>
					</div>
					<div class="mb-3 form-check">
						{{ form_widget(form.disponible, {'attr': {'class': 'form-check-input'}}) }}
						{{ form_label(form.disponible, 'Disponible', {'label_attr': {'class': 'form-check-label'}}) }}
					</div>
					<div class="d-flex justify-content-between">
						<a href="{{ path('app_livreur_index') }}" class="btn btn-light">
							<i class="fas fa-arrow-left me-1"></i>
							Retour à la liste
						</a>
						<div>
							<button type="submit" class="btn btn-primary me-2">
								<i class="fas fa-save me-1"></i>
								Enregistrer les modifications
							</button>
							<a href="{{ path('app_livreur_index') }}" class="btn btn-outline-secondary">
								Annuler
							</a>
						</div>
					</div>
					{{ form_end(form) }}

					<hr class="my-4">
					<div class="d-flex justify-content-end">
						{{ include('livreur/_delete_form.html.twig') }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		// Form validation
(function () {
'use strict'

var forms = document.querySelectorAll('.needs-validation')

Array.prototype.slice.call(forms).forEach(function (form) {
form.addEventListener('submit', function (event) {
if (! form.checkValidity()) {
event.preventDefault()
event.stopPropagation()
}

form.classList.add('was-validated')
}, false)
})
})()
	</script>
{% endblock %}
