<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verification - Aatrii</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #6c5ce7;
            --primary-hover: #5a4bc9;
            --text-color: #2d3436;
            --text-muted: #95a5a6;
            --border-color: #e0e0e0;
            --error-color: #e74c3c;
            --success-color: #2ecc71;
        }
        
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 20px;
        }
        
        .verification-card {
            max-width: 480px;
            margin: 0 auto;
            padding: 2.5rem;
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
            border: none;
        }
        
        .verification-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .verification-icon {
            width: 70px;
            height: 70px;
            background: #f0f4ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }
        
        .verification-icon i {
            font-size: 2rem;
            color: var(--primary-color);
        }
        
        h1 {
            color: var(--text-color);
            font-weight: 700;
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }
        
        .subtitle {
            color: var(--text-muted);
            margin-bottom: 2rem;
            font-size: 1.05rem;
            line-height: 1.6;
        }
        
        .code-inputs {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2rem;
            gap: 10px;
        }
        
        .code-input {
            width: 50px;
            height: 60px;
            text-align: center;
            font-size: 1.5rem;
            font-weight: 600;
            border: 2px solid var(--border-color);
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        
        .code-input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(108, 92, 231, 0.1);
            outline: none;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            padding: 0.75rem;
            font-weight: 600;
            font-size: 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 1rem;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(108, 92, 231, 0.2);
        }
        
        .resend-link {
            text-align: center;
            margin-top: 1.5rem;
            color: var(--text-muted);
        }
        
        .resend-link a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        
        .resend-link a:hover {
            text-decoration: underline;
        }
        
        .alert {
            border-radius: 8px;
            margin-bottom: 1.5rem;
            border: none;
            padding: 1rem 1.25rem;
        }
        
        .alert-danger {
            background-color: #ffebee;
            color: #c62828;
        }
        
        .timer {
            color: var(--primary-color);
            font-weight: 600;
            margin-top: 0.5rem;
        }
        
        .hidden {
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="verification-card">
            <div class="verification-header">
                <div class="verification-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h1>Enter Verification Code</h1>
                <p class="subtitle">We've sent a 6-digit verification code to your email. Please enter it below to continue.</p>
            </div>

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
                </div>
            {% endfor %}

            <form method="post" action="{{ path('app_verification') }}" id="verificationForm">
                <div class="code-inputs">
                    {% for i in 1..6 %}
                        <input type="text" 
                               id="code-{{ i }}" 
                               name="code[]" 
                               class="form-control code-input" 
                               maxlength="1" 
                               pattern="[0-9]" 
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               {% if i == 1 %}autofocus{% endif %}>
                    {% endfor %}
                </div>
                <input type="hidden" id="fullCode" name="code">

                <button type="submit" class="btn btn-primary" id="verifyBtn">
                    <i class="bi bi-shield-check me-2"></i>Verify Code
                </button>
            </form>

            <div class="resend-link">
                <p>Didn't receive a code? 
                    <a href="{{ path('app_reset_password') }}" id="resendLink">Resend</a>
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('verificationForm');
            const codeInputs = document.querySelectorAll('.code-input');
            const fullCodeInput = document.getElementById('fullCode');
            const resendLink = document.getElementById('resendLink');
            let timeLeft = 60;
            let timer;

            // Auto-focus next input and handle backspace
            codeInputs.forEach((input, index) => {
                // Handle input
                input.addEventListener('input', (e) => {
                    if (e.inputType === 'deleteContentBackward') {
                        if (index > 0) {
                            codeInputs[index - 1].focus();
                        }
                    } else if (input.value) {
                        if (index < codeInputs.length - 1) {
                            codeInputs[index + 1].focus();
                        } else {
                            input.blur();
                        }
                    }
                    updateFullCode();
                });

                // Handle paste
                input.addEventListener('paste', (e) => {
                    e.preventDefault();
                    const pasteData = e.clipboardData.getData('text').trim();
                    if (/^\d{6}$/.test(pasteData)) {
                        pasteData.split('').forEach((char, i) => {
                            if (codeInputs[i]) {
                                codeInputs[i].value = char;
                            }
                        });
                        updateFullCode();
                        if (codeInputs[5]) {
                            codeInputs[5].focus();
                        }
                    }
                });

                // Only allow numbers
                input.addEventListener('keypress', (e) => {
                    if (!/[0-9]/.test(e.key)) {
                        e.preventDefault();
                    }
                });
            });

            // Update hidden input with full code
            function updateFullCode() {
                let code = '';
                codeInputs.forEach(input => {
                    code += input.value || '';
                });
                fullCodeInput.value = code;
            }

            // Start countdown timer
            function startTimer() {
                resendLink.style.pointerEvents = 'none';
                resendLink.style.opacity = '0.6';
                
                timer = setInterval(() => {
                    const minutes = Math.floor(timeLeft / 60);
                    const seconds = timeLeft % 60;
                    
                    if (timeLeft <= 0) {
                        clearInterval(timer);
                        resendLink.style.pointerEvents = 'auto';
                        resendLink.style.opacity = '1';
                    } else {
                        timeLeft--;
                    }
                }, 1000);
            }

            // Handle form submission
            form.addEventListener('submit', function(e) {
                const verifyBtn = document.getElementById('verifyBtn');
                verifyBtn.disabled = true;
                verifyBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Verifying...';
                
                updateFullCode();
                
                // If code is not complete, prevent submission
                if (fullCodeInput.value.length !== 6) {
                    e.preventDefault();
                    verifyBtn.disabled = false;
                    verifyBtn.innerHTML = '<i class="bi bi-shield-check me-2"></i>Verify Code';
                    // Show error or highlight empty fields
                    codeInputs.forEach(input => {
                        if (!input.value) {
                            input.style.borderColor = 'var(--error-color)';
                        }
                    });
                }
            });

            // Start the timer when page loads
            startTimer();
        });
    </script>
</body>
</html>